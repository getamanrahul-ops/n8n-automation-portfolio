    {
      "parameters": {
        "jsCode": "// Work out the next Serial Number by looking at the existing\n// \"Picture S/N\" column and taking the max + 1.\nconst rows = $input.all().map(item => item.json);\n\nlet maxSn = 0;\nfor (const row of rows) {\n  const sn = parseInt(row['Picture S/N'], 10);\n  if (!isNaN(sn) && sn > maxSn) maxSn = sn;\n}\nconst newSn = maxSn + 1;\n\nconst parsed = $('Parse Caption').first().json;\n\nreturn [{\n  json: {\n    ...parsed,\n    serialNumber: newSn,\n    fileBaseName: `${newSn}_${parsed.equipmentName}`\n  }\n}];\n"
      },
