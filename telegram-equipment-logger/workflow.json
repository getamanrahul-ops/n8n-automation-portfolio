      "parameters": {
        "jsCode": "// Rename the downloaded binary file to <S/N>_<Equipment Name>.<ext>\nconst items = $input.all();\nconst computed = $('Compute Serial Number').first().json;\nconst item = items[0];\n\nconst binaryData = item.binary.data;\nconst ext = (binaryData.fileExtension || binaryData.mimeType?.split('/')[1] || 'jpg').replace(/[^a-zA-Z0-9]/g, '');\nconst newFileName = `${computed.fileBaseName}.${ext}`;\n\nitem.binary.data.fileName = newFileName;\nitem.json.finalFileName = newFileName;\n\nreturn [item];\n"
      },
