      "id": "c518f75c-ab9c-4ed3-b978-1d222cf6f037",
      "name": "Has Photo + Caption?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -624,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Grab the message and caption\nconst message = $json.channel_post;\nconst caption = message.caption || '';\n\nconst parts = {};\n\n// Split by commas OR new lines, and standardize keys to lowercase\ncaption.split(/,|\\n/).forEach(pair => {\n  const idx = pair.indexOf(':');\n  if (idx === -1) return;\n  \n  // Convert the key to lowercase so \"Equipment Name\" and \"Equipment name\" are treated exactly the same\n  const key = pair.slice(0, idx).trim().toLowerCase();\n  const value = pair.slice(idx + 1).trim();\n  \n  if (key) parts[key] = value;\n});\n\nconst photos = message.photo || [];\nconst largestPhoto = photos[photos.length - 1]; // Grab the highest resolution\n\n// 1. Verify a Type was provided at all\nif (!parts['type']) {\n  throw new Error('Caption missing \"Type\". Received: \"' + caption + '\"');\n}\n\nconst type = parts['type'].toUpperCase();\n\n// Prepare our output variables\nlet panelName = null;\nlet equipmentName = null;\nlet location = null;\nlet details = null;\nlet remark = null;\n\n// 2. Validate based on the specific Type\nif (type === 'E') {\n    panelName = parts['panel name'];\n    equipmentName = parts['equipment name'];\n    location = parts['location'];\n    \n    if (!panelName || !equipmentName || !location) {\n        throw new Error('Electrical caption missing fields. Required: Type, Panel Name, Equipment name, Location. Received: \"' + caption + '\"');\n    }\n} else if (type === 'M') {\n    equipmentName = parts['equipment name'];\n    location = parts['location'];\n    details = parts['details'];\n    remark = parts['remark'];\n    \n    if (!equipmentName || !location || !details || !remark) {\n        throw new Error('Mechanical caption missing fields. Required: Type, Equipment Name, Location, Details, Remark. Received: \"' + caption + '\"');\n    }\n} else {\n    throw new Error('Invalid Type. Must be exactly E or M. Received: \"' + type + '\"');\n}\n\n// 3. Output the structured data for the Switch node\nreturn [{\n  json: {\n    type: type,\n    panelName: panelName,\n    equipmentName: equipmentName,\n    location: location,\n    details: details,\n    remark: remark,\n    chatId: message.chat.id,\n    messageId: message.message_id,\n    fileId: largestPhoto ? largestPhoto.file_id : null\n  }\n}];"
      },
