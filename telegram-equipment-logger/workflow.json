          },
          "conditions": [
            {
              "id": "has-photo-and-caption",
              "leftValue": "={{ Array.isArray($json.channel_post?.photo) && $json.channel_post.photo.length > 0 && typeof $json.channel_post?.caption === 'string' && $json.channel_post.caption.trim().length > 0 }}",
              "rightValue": true,
              "operator": {
